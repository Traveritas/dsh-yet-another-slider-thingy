{
  "name": "dsh-thinking-slider",
  "version": "0.1.1",
  "description": "接管 DSH composer 的模型位：模型行 + 思考强度滑条。Composer model seat with a discrete reasoning-effort slider.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/selftest.mjs"
  },
  "license": "MIT"
}
